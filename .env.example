# Generate your own with: openssl rand -hex 16
N8N_ENCRYPTION_KEY=replace-with-your-own-32-char-key

POSTGRES_USER=dabacities
POSTGRES_PASSWORD=replace-with-your-own-password
POSTGRES_DB=content_pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Must match the value in n8n's Wait-node Header Auth credential exactly
APPROVAL_SECRET=replace-with-your-own-secret

# Same key used in n8n's Imejis HTTP Request node credential
IMEJIS_API_KEY=replace-with-your-imejis-key
